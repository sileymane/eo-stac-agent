# Copy to .env and fill in.
# Model as "provider:model" (LangChain init_chat_model format)
LLM_MODEL=openai:gpt-4.1-mini
OPENAI_API_KEY=
# LLM_MODEL=google_genai:gemini-3.5-flash
# GOOGLE_API_KEY=

# Seconds before an LLM request is abandoned (it is retried once).
LLM_TIMEOUT=60
# Gemini only: low | medium | high (higher = slower; gemini-3.8-flash rejects minimal)
LLM_REASONING_EFFORT=low

# Any STAC API works; Earth Search (AWS) is public and needs no auth.
STAC_URL=https://earth-search.aws.element84.com/v1

# Use the OS certificate store (required behind TLS-inspecting corporate proxies)
USE_SYSTEM_CERTS=true
