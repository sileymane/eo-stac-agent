# Copy to .env and fill in.
# Model as "provider:model" (LangChain init_chat_model format)
LLM_MODEL=openai:gpt-4.1-mini
OPENAI_API_KEY=
# LLM_MODEL=google_genai:gemini-3.5-flash
# GOOGLE_API_KEY=
# OpenRouter: one key for many vendors' models; ids are "vendor/model" (https://openrouter.ai/models).
# Pick a model that supports tool calling (the request parser needs it).
# LLM_MODEL=openrouter:google/gemini-3.5-flash
# OPENROUTER_API_KEY=

# Seconds before an LLM request is abandoned (it is retried once).
LLM_TIMEOUT=60
# Gemini: low | medium | high (default low; higher = slower; gemini-3.8-flash rejects minimal).
# OpenRouter: only sent when set, since not every model it serves can reason.
LLM_REASONING_EFFORT=low

# Any STAC API works; Earth Search (AWS) is public and needs no auth.
STAC_URL=https://earth-search.aws.element84.com/v1

# Use the OS certificate store (required behind TLS-inspecting corporate proxies)
USE_SYSTEM_CERTS=true
